# Server-only read token for password-protected case studies (not used by the home page yet)
SANITY_READ_TOKEN=

# Turnstile (contact form)
# PUBLIC_TURNSTILE_SITE_KEY=
# PUBLIC_TURNSTILE_DISABLED=false

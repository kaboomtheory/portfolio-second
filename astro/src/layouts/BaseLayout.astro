---
/**
 * Site shell: ports nuxt.config `app.head`, app.vue and layouts/default.vue.
 * Page transitions from default.vue are not ported yet (Astro view transitions
 * are the likely replacement once more pages exist).
 */
import '~/styles/fonts.css'
import '~/styles/tailwind.css'
import '~/styles/main.css'
import '~/styles/transitions.css'
import '~/styles/brand.css'
import SpeedInsights from '@vercel/speed-insights/astro'
import BxNav from '~/components/bx/BxNav.astro'
import BxFooter from '~/components/bx/BxFooter.astro'

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogTitle?: string
  ogImage?: string
  /** Sets data-home-landing on <html>, like the Nuxt layout did on "/". */
  homeLanding?: boolean
  /** Adds robots noindex (password and protected pages). */
  noindex?: boolean
  /** Redesigned pages own their full-width layout; older pages keep the centered container. */
  bare?: boolean
}

const siteTitle = 'Bryan X. Mendez Graphic Design Portfolio'
const siteDescription =
  'Portfolio of Bryan X. Mendez — graphic designer in Los Angeles. Brand identity, packaging, and digital experiences.'
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://bryanxmendez.com').replace(/\/$/, '')

const {
  title = siteTitle,
  description = siteDescription,
  canonical,
  ogTitle = siteTitle,
  ogImage = `${siteUrl}/og-default.png`,
  homeLanding = false,
  noindex = false,
  bare = false,
} = Astro.props
---

<!doctype html>
<html lang="en" data-home-landing={homeLanding ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3f7fb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Clears the old dark mode setting before first paint. -->
    <script is:inline src="/theme-init.js"></script>

    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />

    <script is:inline src="/clarity.js" async></script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <BxNav currentPath={Astro.url.pathname} />
    {
      bare ? (
        <main id="main-content" class="bx-main" tabindex="-1">
          <slot />
        </main>
      ) : (
        <div class="layout-header-pad bx-legacy">
          <div class="layout-main-shell relative z-[1] container mx-auto flex w-full min-w-0 max-w-full flex-col px-0 pb-6 md:max-w-[82rem]">
            <main id="main-content" class="relative min-w-0 w-full" tabindex="-1">
              <div class:list={['layout-page-frame min-w-0 w-full', { 'layout-page-frame--home-landing': homeLanding }]}>
                <slot />
              </div>
            </main>
          </div>
        </div>
      )
    }
    <BxFooter />
    <SpeedInsights />

    <script>
      import { initLenis } from '~/scripts/lenis'
      import { initHashLinks, printConsoleSignature } from '~/scripts/hashLinks'

      initLenis()
      initHashLinks()
      printConsoleSignature()
    </script>
  </body>
</html>

<style is:global>
  .bx-main {
    position: relative;
    min-width: 0;
    outline: none;
  }

  .bx-legacy {
    padding-top: 112px;
  }
</style>

---
/**
 * Error page body for 404 and 500, in the Redline style.
 * "Try again" reloads the requested URL; "Back to home" goes to /.
 */
interface Props {
  code: number
  heading: string
  detail: string
  retryHref: string
}
const { code, heading, detail, retryHref } = Astro.props
---

<div class="bx-page err">
  <div class="bx-wrap err__inner">
    <p class="bx-sec">§ {code} · <span class="bx-q">{code === 404 ? 'Lost' : 'Error'}</span></p>
    <span class="bx-dim err__dim" aria-hidden="true">{code} PX</span>
    <h1 class="err__h">{heading}.</h1>
    <p class="err__detail">{detail}</p>
    <div class="err__actions">
      <a href="/" class="bx-pill bx-pill--ink">Back to home</a>
      <a href={retryHref} class="bx-pill bx-pill--line">Try again</a>
    </div>
  </div>
</div>

<style>
  .err {
    padding-top: 160px;
    min-height: 60svh;
  }

  .err__inner {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .err__dim {
    max-width: 720px;
    margin-top: 32px;
  }

  .err__h {
    margin: 0 0 0 -0.04em;
    font-weight: 700;
    font-size: clamp(52px, 8.4vw, 120px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .err__detail {
    margin: 0;
    font-size: 22px;
    line-height: 1.4;
    color: var(--bx-mid);
  }

  .err__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
</style>

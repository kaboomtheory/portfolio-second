---
/**
 * Site navigation: one centered glass pill, identical on every page.
 * The active item is filled with ink. No theme toggle (the site is light only).
 */
interface Props {
  currentPath: string
}
const { currentPath } = Astro.props
const path = currentPath.replace(/\/+$/, '') || '/'

const items = [
  { label: 'Home', href: '/', active: path === '/' },
  { label: 'Work', href: '/#work', active: path.startsWith('/projects') || path.startsWith('/password') },
  { label: 'About', href: '/about', active: path.startsWith('/about') },
]
---

<header class="bx-nav">
  <nav aria-label="Main" class="bx-nav__pill">
    {
      items.map((item) => (
        <a
          href={item.href}
          class:list={['bx-nav__link bx-focus', { 'is-active': item.active }]}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .bx-nav {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding: calc(20px + env(safe-area-inset-top, 0px)) 16px 0;
    pointer-events: none;
  }

  .bx-nav__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: var(--bx-glass-bg);
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
    backdrop-filter: blur(22px) saturate(1.5);
    border: 1px solid var(--bx-glass-border);
    box-shadow:
      inset 0 1px 0 var(--bx-glass-hi),
      var(--bx-glass-shadow);
  }

  .bx-nav__link {
    padding: 10px 18px;
    border-radius: 999px;
    color: var(--bx-ink);
    font-family: var(--bx-sans);
    font-weight: 500;
    font-size: 15px;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .bx-nav__link:hover {
    background: rgba(16, 26, 44, 0.06);
  }

  .bx-nav__link.is-active {
    background: var(--bx-ink);
    color: var(--bx-bg);
    font-weight: 600;
  }
</style>
